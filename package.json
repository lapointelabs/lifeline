{
  "name": "@lapointelabs/lifeline",
  "version": "0.2.0",
  "description": "Find deprecated AI APIs and models before they break production.",
  "type": "module",
  "bin": {
    "lifeline": "bin/lifeline.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/catalog.test.js test/cli.test.js test/ignore.test.js test/render.test.js test/scanner.test.js",
    "test:cli": "node --test test/cli.test.js",
    "release:check": "node scripts/release-check.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20.1"
  },
  "keywords": [
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "google-ai",
    "deprecation",
    "migration",
    "responses-api",
    "assistants-api",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapointelabs/lifeline.git"
  },
  "bugs": {
    "url": "https://github.com/lapointelabs/lifeline/issues"
  },
  "homepage": "https://github.com/lapointelabs/lifeline#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
